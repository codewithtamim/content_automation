# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
ADMIN_TELEGRAM_CHAT_ID=your_chat_id
ADMIN_TELEGRAM_USERNAME=your_username

# Database (SQLite, default path works out of the box)
# DATABASE_URL=sqlite:///data/tiktok_automation.db

# Optional: Gemini model (keys added via bot)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Batch size for Gemini metadata (N jobs = 1 API call). Max 30 recommended.
# GEMINI_METADATA_BATCH_SIZE=30

# Optional: Persist metadata cache to DB (saves Gemini cost across restarts)
# USE_METADATA_DB_CACHE=true

# Optional: Max video resolution for downloads (720, 1080). Unset = best available.
# YT_MAX_RESOLUTION=720

# Optional: Instagram session persistence path
# INSTAGRAM_SESSION_PATH=data/sessions

# Optional: Run VACUUM when worker idle for N iterations. 0 = disabled.
# DB_VACUUM_IDLE_ITERATIONS=0

# Optional: Video storage path (default: data/videos)
# VIDEO_STORAGE_PATH=data/videos

# Optional: YouTube cookies. Upload via bot (Manage credentials → Upload YouTube cookies).
# Or set path to file. Default: cookies.txt in project root
# YT_COOKIES_PATH=cookies.txt

# Optional: HTTP proxy for YouTube downloads (helps if VPS IP is blocked by YouTube)
# YT_PROXY=http://user:pass@proxy.example.com:8080

# Optional: Log level (DEBUG, INFO, WARNING, ERROR). Default: INFO
# LOG_LEVEL=INFO
